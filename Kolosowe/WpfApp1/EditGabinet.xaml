<Window x:Class="WpfApp1.EditGabinet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="EditGabinet" Height="320" Width="326">
    <Grid>
        <Button Name="EditBtn" Content="Edytuj" HorizontalAlignment="Center" Margin="0,52,0,0" VerticalAlignment="Top" Height="55" Width="171" Click="EditBtn_Click"/>
        <Label Content="Adres:" HorizontalAlignment="Left" Margin="23,141,0,0" VerticalAlignment="Top" Width="124"/>
        <TextBox Name="adresTekst" HorizontalAlignment="Left" Margin="152,145,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Liczba pracowników:" HorizontalAlignment="Left" Margin="23,171,0,0" VerticalAlignment="Top" Width="124"/>
        <TextBox Name="liczbaTekst" HorizontalAlignment="Left" Margin="152,175,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Numer gabinetu:" HorizontalAlignment="Left" Margin="23,204,0,0" VerticalAlignment="Top" Width="124"/>
        <TextBox Name="numerTekst" HorizontalAlignment="Left" Margin="152,208,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Id:" HorizontalAlignment="Left" Margin="23,234,0,0" VerticalAlignment="Top" Width="124"/>
        <TextBox Name="IdTekst" HorizontalAlignment="Left" Margin="152,238,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
