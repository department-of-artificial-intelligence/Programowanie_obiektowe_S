<Window x:Class="Lab7.APP.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab7.APP"
        mc:Ignorable="d"
        Title="Calculator" Height="276" Width="300" ResizeMode="NoResize">
    <Grid>
        <TextBlock x:Name="TextBar" Height="20" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="280" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        <Button x:Name="Button_1" Content="1" HorizontalAlignment="Left" Margin="10,35,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_2" Content="2" HorizontalAlignment="Left" Margin="55,35,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_3" Content="3" HorizontalAlignment="Left" Margin="100,35,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_4" Content="4" HorizontalAlignment="Left" Margin="10,80,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_5" Content="5" HorizontalAlignment="Left" Margin="55,80,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_6" Content="6" HorizontalAlignment="Left" Margin="100,80,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_7" Content="7" HorizontalAlignment="Left" Margin="10,125,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_8" Content="8" HorizontalAlignment="Left" Margin="55,125,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_9" Content="9" HorizontalAlignment="Left" Margin="100,125,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_0" Content="0" HorizontalAlignment="Left" Margin="10,170,0,0" VerticalAlignment="Top" Height="40" Width="85" Click="Button_Click"/>
        <Button x:Name="Button_Plus" Content="+" HorizontalAlignment="Right" Margin="0,35,55,0" VerticalAlignment="Top" Height="85" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_Minus" Content="-" HorizontalAlignment="Right" Margin="0,35,10,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_Multiply" Content="*" HorizontalAlignment="Right" Margin="0,80,10,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_C" Content="C" HorizontalAlignment="Right" Margin="0,125,10,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_Slash" Content="/" HorizontalAlignment="Right" Margin="0,125,55,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="Button_Dot" Content="." HorizontalAlignment="Left" Margin="100,170,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>

    </Grid>
</Window>
