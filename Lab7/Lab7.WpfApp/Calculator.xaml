<Window x:Class="Lab7.WpfApp.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab7.WpfApp"
        mc:Ignorable="d"
        Title="Calculator" Height="450" Width="800">
    <Grid Margin="1,0,-6,0">
        <Grid Margin="0,0,400,0">
            <Button Content="1" HorizontalAlignment="Left" Margin="38,140,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
            <Button Content="2" HorizontalAlignment="Left" Margin="78,140,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_2"/>
            <Button Content="3" HorizontalAlignment="Left" Margin="118,140,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_3"/>
            <Button Content="4" HorizontalAlignment="Left" Margin="38,180,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_4"/>
            <Button Content="5" HorizontalAlignment="Left" Margin="78,180,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_5"/>
            <Button Content="6" HorizontalAlignment="Left" Margin="118,180,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_6"/>
            <Button Content="7" HorizontalAlignment="Left" Margin="38,220,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_7"/>
            <Button Content="8" HorizontalAlignment="Left" Margin="78,220,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_8"/>
            <Button Content="9" HorizontalAlignment="Left" Margin="118,220,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_9"/>
            <Button Content="0" HorizontalAlignment="Left" Margin="38,260,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_0"/>
            <Button Content="." HorizontalAlignment="Left" Margin="78,340,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_Dot"/>
            <Button Content="C" HorizontalAlignment="Left" Margin="324,115,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_Clear"/>
            <Button Content="*" HorizontalAlignment="Left" Margin="324,165,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_Mul"/>
            <Button Content="/" HorizontalAlignment="Left" Margin="324,215,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_Div"/>
            <Button Content="=" HorizontalAlignment="Left" Margin="274,265,0,0" VerticalAlignment="Top" Height="40" Width="90" Click="Button_Click_Equals"/>
            <Button Content="-" HorizontalAlignment="Left" Margin="274,215,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click_Minus"/>
            <Button Content="+" HorizontalAlignment="Left" Margin="275,115,0,0" VerticalAlignment="Top" Height="90" Width="40" Click="Button_Click_Plus"/>
            <TextBox x:Name="textBox" HorizontalAlignment="Left" Margin="38,40,0,0" TextWrapping="Wrap" TextAlignment="Right" Padding="0,5" VerticalAlignment="Top" Width="324" Height="30"/>
        </Grid>

    </Grid>
</Window>
