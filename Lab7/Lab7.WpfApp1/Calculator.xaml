<Window x:Class="Lab7.WpfApp1.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab7.WpfApp1"
        mc:Ignorable="d"
        Title="Calculator" Height="452" Width="547">
    <Grid Margin="10,0,10,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="77*"/>
            <RowDefinition Height="13*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="37*"/>
            <ColumnDefinition Width="481*"/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <TextBox HorizontalAlignment="Left" TextWrapping="Wrap" Text="0" VerticalAlignment="Center" Width="496" Height="18" TextAlignment="Right" Grid.Column="1" Margin="7,0,0,0" Grid.ColumnSpan="2"/>
        <Button x:Name="Button_0" Content="0" HorizontalAlignment="Left" Margin="1,38,0,0" Grid.Row="1" VerticalAlignment="Top" Click="Button_Click" Width="50" Height="50" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Button x:Name="Button_1" Content="1" HorizontalAlignment="Left" Margin="14,38,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="2"/>
        <Button x:Name="Button_2" Content="2" HorizontalAlignment="Left" Margin="64,38,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="2"/>
        <Button x:Name="Button_3" Content="3" HorizontalAlignment="Left" Margin="1,88,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" RenderTransformOrigin="-0.18,-0.007" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Button x:Name="Button_4" Content="4" HorizontalAlignment="Left" Margin="14,88,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" RenderTransformOrigin="-0.3,-0.107" Grid.Column="2"/>
        <Button x:Name="Button_5" Content="5" HorizontalAlignment="Left" Margin="64,88,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="2"/>
        <Button x:Name="Button_6" Content="6" HorizontalAlignment="Left" Margin="1,138,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Button x:Name="Button_7" Content="7" HorizontalAlignment="Left" Margin="14,138,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="2"/>
        <Button x:Name="Button_8" Content="8" HorizontalAlignment="Left" Margin="64,138,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="2"/>
        <Button x:Name="Button_9" Content="9" HorizontalAlignment="Left" Margin="1,188,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Button x:Name="Button_Add" Content="+" HorizontalAlignment="Left" Margin="168,13,0,0" VerticalAlignment="Top" Width="50" Height="105" Grid.Row="1" Grid.Column="2"/>
        <Button x:Name="Button_C" Grid.Column="2" Content="C" HorizontalAlignment="Left" Margin="223,13,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50"/>
        <Button x:Name="Button_Multiply" Grid.Column="2" Content="*" HorizontalAlignment="Left" Margin="223,68,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50"/>
        <Button x:Name="Button_Sub" Grid.Column="2" Content="-" HorizontalAlignment="Left" Margin="168,125,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50"/>
        <Button x:Name="Button_Div" Grid.Column="2" Content="/" HorizontalAlignment="Left" Margin="223,125,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="50"/>
        <Button x:Name="Button_Calc" Grid.Column="2" Content="=" HorizontalAlignment="Left" Margin="168,180,0,0" Grid.Row="1" VerticalAlignment="Top" Width="105" Height="50"/>
        <Button x:Name="Button_Dot" Grid.Column="2" Content="." HorizontalAlignment="Left" Margin="14,255,0,0" Grid.Row="1" VerticalAlignment="Top" Width="50" Height="45"/>
    </Grid>
</Window>
