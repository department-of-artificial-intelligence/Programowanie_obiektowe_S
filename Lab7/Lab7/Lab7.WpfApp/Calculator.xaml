<Window x:Class="Lab7.WpfApp.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculator" Height="400" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="Display" FontSize="36" HorizontalAlignment="Stretch"
             VerticalAlignment="Top" IsReadOnly="True" Text="0"
             Margin="0,0,0,10" TextAlignment="Right"/>

        <UniformGrid Grid.Row="1" Columns="4" Rows="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">
            <Button Content="C" Click="Clear_Click" FontSize="20"/>
            <Button Content="%" Click="Percentage_Click" FontSize="20"/>
            <Button Content="/" Click="Operator_Click" FontSize="20"/>
            <Button Content="*" Click="Operator_Click" FontSize="20"/>

            <Button Content="7" Click="Button_Click" FontSize="20"/>
            <Button Content="8" Click="Button_Click" FontSize="20"/>
            <Button Content="9" Click="Button_Click" FontSize="20"/>
            <Button Content="-" Click="Operator_Click" FontSize="20"/>

            <Button Content="4" Click="Button_Click" FontSize="20"/>
            <Button Content="5" Click="Button_Click" FontSize="20"/>
            <Button Content="6" Click="Button_Click" FontSize="20"/>
            <Button Content="+" Click="Operator_Click" FontSize="20"/>

            <Button Content="1" Click="Button_Click" FontSize="20"/>
            <Button Content="2" Click="Button_Click" FontSize="20"/>
            <Button Content="3" Click="Button_Click" FontSize="20"/>
            <Button Content="=" Click="Equals_Click" FontSize="20"/>

            <Button Content="0" Click="Button_Click" FontSize="20" Grid.ColumnSpan="2"/>
            <Button Content="." Click="Button_Click" FontSize="20"/>
        </UniformGrid>
    </Grid>
</Window>
