<Window x:Class="Lab7WpfApp.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab7WpfApp"
        mc:Ignorable="d"
        Title="Calculator" Height="360" Width="340">
    <Grid HorizontalAlignment="Left" Width="340">
        <Button x:Name="Button0" Content="0" HorizontalAlignment="Left" Height="40" Margin="32,87,0,0" VerticalAlignment="Top" Width="39" Click="Button0_Click"/>
        <Button x:Name="Button1" Content="1" HorizontalAlignment="Left" Height="40" Margin="71,87,0,0" VerticalAlignment="Top" Width="39" Click="Button1_Click"/>
        <Button Content="2" HorizontalAlignment="Left" Height="40" Margin="110,87,0,0" VerticalAlignment="Top" Width="39" Click="Button2_Click"/>
        <Button Content="3" HorizontalAlignment="Left" Height="40" Margin="32,127,0,0" VerticalAlignment="Top" Width="39" Click="Button3_Click"/>
        <Button Content="4" HorizontalAlignment="Left" Height="40" Margin="71,127,0,0" VerticalAlignment="Top" Width="39" Click="Button4_Click"/>
        <Button Content="5" HorizontalAlignment="Left" Height="40" Margin="110,127,0,0" VerticalAlignment="Top" Width="39" Click="Button5_Click"/>
        <Button Content="6" HorizontalAlignment="Left" Height="40" Margin="32,167,0,0" VerticalAlignment="Top" Width="39" Click="Button6_Click"/>
        <Button Content="7" HorizontalAlignment="Left" Height="40" Margin="71,167,0,0" VerticalAlignment="Top" Width="39" Click="Button7_Click"/>
        <Button Content="8" HorizontalAlignment="Left" Height="40" Margin="110,167,0,0" VerticalAlignment="Top" Width="39" Click="Button8_Click"/>
        <Button Content="9" HorizontalAlignment="Left" Height="40" Margin="32,207,0,0" VerticalAlignment="Top" Width="39" Click="Button9_Click"/>
        <Button x:Name="ButtonDot" Content="." HorizontalAlignment="Left" Height="40" Margin="76,267,0,0" VerticalAlignment="Top" Width="39" Click="ButtonDot_Click"/>
        <Button x:Name="Plus" Content="+" HorizontalAlignment="Left" Height="85" Margin="227,87,0,0" VerticalAlignment="Top" Width="39" Click="Plus_Click"/>
        <Button x:Name="C" Content="C" HorizontalAlignment="Left" Height="40" Margin="271,87,0,0" VerticalAlignment="Top" Width="39" Click="C_Click"/>
        <Button x:Name="Multi" Content="*" HorizontalAlignment="Left" Height="40" Margin="271,132,0,0" VerticalAlignment="Top" Width="39"/>
        <Button x:Name="Div" Content="/" HorizontalAlignment="Left" Height="40" Margin="271,177,0,0" VerticalAlignment="Top" Width="39"/>
        <Button x:Name="Minus" Content="-" HorizontalAlignment="Left" Height="40" Margin="227,177,0,0" VerticalAlignment="Top" Width="39"/>
        <Button x:Name="Calc" Content="=" HorizontalAlignment="Left" Height="40" Margin="227,222,0,0" VerticalAlignment="Top" Width="83"/>
        <TextBox x:Name="OutPut" HorizontalAlignment="Left" Margin="32,40,0,0" TextWrapping="NoWrap" Text="0" VerticalAlignment="Top" Width="278" TextChanged="OutPut_TextChanged" FlowDirection="RightToLeft"/>

    </Grid>
</Window>
