<Window x:Class="Lab7WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab7WpfApp1"
        mc:Ignorable="d"
        Title="Calculator" Height="448" Width="362">
    <Grid RenderTransformOrigin="0.475,0.44" Margin="10,26,21,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="106*"/>
            <ColumnDefinition Width="601*"/>
            <ColumnDefinition Width="28*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="zero" Content="0" HorizontalAlignment="Left" Margin="35,0,0,0" VerticalAlignment="Center" Click="zero" Width="50" Height="50" Grid.ColumnSpan="2"/>
        <Button x:Name="one" Content="1" HorizontalAlignment="Left" Margin="30,0,0,0" VerticalAlignment="Center" Width="50" Height="50" Grid.Column="1"/>
        <Button x:Name="two" Content="2" HorizontalAlignment="Left" Margin="80,0,0,0" VerticalAlignment="Center" Width="50" Height="50" Grid.Column="1"/>
        <Button x:Name="three" Content="3" HorizontalAlignment="Left" Margin="35,224,0,0" VerticalAlignment="Top" Width="50" Height="50" RenderTransformOrigin="-0.31,0.543" Grid.ColumnSpan="2"/>
        <Button x:Name="four" Content="4" HorizontalAlignment="Left" Margin="30,224,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1"/>
        <Button x:Name="five" Content="5" HorizontalAlignment="Left" Margin="80,224,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1"/>
        <Button x:Name="six" Content="6" HorizontalAlignment="Left" Margin="35,274,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.ColumnSpan="2"/>
        <Button x:Name="seven" Content="7" HorizontalAlignment="Left" Margin="30,274,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1"/>
        <Button Content="8" HorizontalAlignment="Left" Margin="80,274,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1"/>
        <Button x:Name="nine" Content="9" HorizontalAlignment="Left" Margin="35,324,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.ColumnSpan="2"/>
        <Button x:Name="dot" Content="." HorizontalAlignment="Left" Margin="30,324,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1"/>
        <Label x:Name="Display" Content="0" HorizontalAlignment="Left" Margin="55,130,0,0" VerticalAlignment="Top" Width="192" FlowDirection="RightToLeft" Grid.Column="1"/>
        <Button x:Name="equal" Content="Button" HorizontalAlignment="Left" Margin="155,324,0,0" VerticalAlignment="Top" Width="100" Height="50" Grid.Column="1"/>
        <Button x:Name="minus" Content="-" HorizontalAlignment="Left" Margin="155,274,0,0" VerticalAlignment="Top" Width="50" Height="50" RenderTransformOrigin="-0.185,-0.093" Grid.Column="1"/>
        <Button x:Name="dziel" Content="/" HorizontalAlignment="Left" Margin="205,274,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1"/>
        <Button x:Name="add" Content="+" HorizontalAlignment="Left" Margin="155,174,0,0" VerticalAlignment="Top" Width="50" Height="100" Grid.Column="1"/>
        <Button x:Name="mnoz" Content="*" HorizontalAlignment="Left" Margin="205,224,0,0" VerticalAlignment="Top" Width="50" Height="50" Grid.Column="1"/>
        <Button x:Name="C" Content="C" HorizontalAlignment="Left" Margin="205,0,0,0" VerticalAlignment="Center" Width="50" Height="50" Grid.Column="1"/>

    </Grid>
</Window>
