<Window x:Class="Lab8.WpfApp.AddGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="Add Grade" Height="200" Width="330">
    <Grid>
        <Label Content="Grade:" HorizontalAlignment="Left" Margin="40,30,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="158,37,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="106" Name="TextBoxGrade"/>
        <Button Content="Add grade" HorizontalAlignment="Left" Margin="40,80,40,30" VerticalAlignment="Top" Width="220" Height="35" Click="ButtonAddGrade_Click"/>
    </Grid>
</Window>
