<Window x:Class="Lab8.WpfApp.AddGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Grade" Height="350" Width="500">
    <Grid Margin="15">
        <Label Content="Subject:" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="TextBoxSubject" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,10,10,0" Width="250" FontSize="14"/>

        <Label Content="Score:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,50,0,0" FontSize="14"/>
        <TextBox x:Name="TextBoxScore" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,50,10,0" Width="250" FontSize="14"/>

        <Label Content="Date:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,90,0,0" FontSize="14"/>
        <DatePicker x:Name="DatePickerGradeDate" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,90,10,0" Width="250" FontSize="14"/>

        <Button Content="Add Grade" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,130,0,0" Width="250" Height="35" Click="ButtonAddGrade_Click"/>
    </Grid>
</Window>
