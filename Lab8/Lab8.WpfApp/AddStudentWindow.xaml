<Window x:Class="Lab8.WpfApp.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="AddStudentWindow" Height="418" Width="344">
    <Grid Margin="0,0,0,-6">
        <TextBox x:Name="TextBoxFirstName" HorizontalAlignment="Left" Margin="130,66,0,0" TextWrapping="Wrap" Text=" " VerticalAlignment="Top" Width="182" RenderTransformOrigin="0.492,0.559" Height="32"/>
        <TextBox x:Name="TextBoxSurName" HorizontalAlignment="Left" Margin="130,116,0,0" TextWrapping="Wrap" Text=" " VerticalAlignment="Top" Width="182" Height="31"/>
        <TextBox x:Name="TextBoxStudentNo" HorizontalAlignment="Left" Margin="130,179,0,0" TextWrapping="Wrap" Text=" " VerticalAlignment="Top" Width="182" Height="36"/>
        <TextBox x:Name="TextBoxFaculty" HorizontalAlignment="Left" Margin="130,244,0,0" TextWrapping="Wrap" Text=" " VerticalAlignment="Top" Width="182" Height="36"/>
        <Label Content="First Name:" HorizontalAlignment="Left" Margin="22,62,0,0" VerticalAlignment="Top" Height="36" Width="92" FontSize="16"/>
        <Label Content="Sur Name:" HorizontalAlignment="Left" Margin="22,116,0,0" VerticalAlignment="Top" Height="31" Width="92" FontSize="16"/>
        <Label Content="Student no:" HorizontalAlignment="Left" Margin="22,179,0,0" VerticalAlignment="Top" Height="36" Width="92" FontSize="16"/>
        <Label Content="Faculty: " HorizontalAlignment="Left" Margin="22,244,0,0" VerticalAlignment="Top" Height="36" Width="92" FontSize="16"/>
        <Button x:Name="ButtonAddStudent" Content="Add student" HorizontalAlignment="Center" Margin="0,321,0,0" VerticalAlignment="Top" Height="55" Width="190" FontSize="16" Click="ButtonAddStudent_Click"/>

    </Grid>
</Window>
