<Window x:Class="Lab8.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid RenderTransformOrigin="0.504,0.454">
        <DataGrid x:Name="DataGridStudents" Margin="13,67,13,10" />
        <Button x:Name="AddButton" Content="Add" HorizontalAlignment="Left" Margin="13,10,0,0" VerticalAlignment="Top" Height="52" Width="105" Click="AddButton_Click"/>
        <Button x:Name="DeleteButton" Content="Delete" HorizontalAlignment="Left" Margin="123,10,0,0" VerticalAlignment="Top" Height="52" Width="105" Click="DeleteButton_Click"/>

    </Grid>
</Window>
