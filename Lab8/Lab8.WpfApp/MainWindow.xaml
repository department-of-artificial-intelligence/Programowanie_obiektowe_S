<Window x:Class="Lab8.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="ButtonAddStudent" Content="Add student" HorizontalAlignment="Left" Margin="21,16,0,0" VerticalAlignment="Top"/>
        <Button x:Name="ButtonDeleteStudent" Content="Delete student" HorizontalAlignment="Left" Margin="104,16,0,0" VerticalAlignment="Top"/>
        <DataGrid x:Name="DataGridStudents" HorizontalAlignment="Left" Height="112" Margin="10,45,0,0" VerticalAlignment="Top" Width="521" d:ItemsSource="{d:SampleData}" SelectedIndex="0"/>
        

    </Grid>
</Window>
