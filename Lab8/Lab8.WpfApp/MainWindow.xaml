<Window x:Class="Lab8.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="Students" Height="450" Width="800">
    <Grid>
        <Button Content="Add Student&#xD;&#xA;" Click="AddStudentBTN" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="24" Width="103"/>
        <DataGrid x:Name="DataGridStudents" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,59,0,-60"/>
        <Button Content="Delete Student&#xD;&#xA;" Click="DeleteStudentBTN" HorizontalAlignment="Left" Margin="130,10,0,0" VerticalAlignment="Top" Height="24" Width="103"/>
        <Button Content="Add Grade" Click="AddGradeBTN" HorizontalAlignment="Left" Margin="253,12,0,0" VerticalAlignment="Top"/>


    </Grid>
</Window>
