<Window x:Class="Lab8.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="DataGridStudents" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="112,78,112,77"/>
        <Button x:Name ="ButtonAddStudent" Content="Add student" HorizontalAlignment="Left" Margin="153,266,0,0" VerticalAlignment="Top" Click="AddStudent_Click"/>
        <Button x:Name ="ButtonRemoveStudent" Content="Delete student" HorizontalAlignment="Left" Margin="260,266,0,0" VerticalAlignment="Top" Click="ButtonRemoveStudentWindowShow_Click"/>
    </Grid>
    
</Window>
