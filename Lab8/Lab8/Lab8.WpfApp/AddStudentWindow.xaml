<Window x:Class="Lab8.WpfApp.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="Add Student" Height="350" Width="330">
    <Grid>
        <Label Content="First name:" HorizontalAlignment="Left" Margin="40,30,0,0" VerticalAlignment="Top"/>
        <Label Content="Last name:" HorizontalAlignment="Left" Margin="40,70,0,0" VerticalAlignment="Top"/>
        <Label Content="Numer indeksu:" HorizontalAlignment="Left" Margin="40,110,0,0" VerticalAlignment="Top"/>
        <Label Content="Department:" HorizontalAlignment="Left" Margin="40,150,0,0" VerticalAlignment="Top"/>
        <Button Content="Add student" HorizontalAlignment="Left" Margin="40,210,40,30" VerticalAlignment="Top" Width="220" Height="35" Click="ButtonAddStudent_Click"/>
        <TextBox HorizontalAlignment="Left" Margin="158,37,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="106" Name="TextBoxFisrtName"/>
        <TextBox HorizontalAlignment="Left" Margin="158,77,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="106" Name="TextBoxLastName"/>
        <TextBox HorizontalAlignment="Left" Margin="158,117,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="106" Name="TextBoxNumerIndeksu"/>
        <TextBox HorizontalAlignment="Left" Margin="158,157,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="106" Name="TextBoxDepartment"/>

    </Grid>
</Window>
