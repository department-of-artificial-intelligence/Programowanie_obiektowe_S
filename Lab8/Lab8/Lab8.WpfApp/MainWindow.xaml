<Window x:Class="Lab8.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600">
    <Grid>
        <Button Name ="ButtonAddStudent" Content="Add student" HorizontalAlignment="Left" Height="42" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Click="ButtonAddStudent_Click"/>
        <Button x:Name ="ButtonAddStudent_Copy" Content="Delete student" HorizontalAlignment="Left" Height="42" Margin="173,10,0,0" VerticalAlignment="Top" Width="120" Click="ButtonAddStudent_Click"/>
        <DataGrid Name="DataGridStudents" HorizontalAlignment="Left" Height="284" Margin="10,80,0,0" VerticalAlignment="Top" Width="564" d:ItemsSource="{d:SampleData ItemCount=5}"/>
    </Grid>
</Window>
