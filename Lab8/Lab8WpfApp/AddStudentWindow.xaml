<Window x:Class="Lab8WpfApp.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8WpfApp"
        mc:Ignorable="d"
        Title="Add Student" Height="450" Width="400">

    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <TextBlock Text="First Name:" Margin="0,10,0,0"/>
            <TextBox x:Name="TextBoxFirstName" Height="30"/>

            <TextBlock Text="Last Name:" Margin="0,10,0,0"/>
            <TextBox x:Name="TextBoxLastName" Height="30"/>

            <TextBlock Text="Faculty:" Margin="0,10,0,0"/>
            <TextBox x:Name="TextBoxFaculty" Height="30"/>

            <TextBlock Text="Student No:" Margin="0,10,0,0"/>
            <TextBox x:Name="TextBoxStudentNo" Height="30"/>

            <Button x:Name="AddStudent" Content="Add Student" Height="40" Margin="0,20,0,0" Click="AddStudentClick"/>
        </StackPanel>
    </Grid>
</Window>
