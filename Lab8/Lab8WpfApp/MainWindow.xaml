<Window x:Class="Lab8WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1000">
    <Grid>
        <DataGrid x:Name="DataGridStudents" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,88,0,0"/>
        <Button x:Name="AddStudent" Content="Add Button" HorizontalAlignment="Left" Margin="38,26,0,0" VerticalAlignment="Top" Height="40" Width="200" Click="AddStudentClick"/>
        <Button Content="Remove Button" HorizontalAlignment="Left" Margin="329,26,0,0" VerticalAlignment="Top" Height="40" Width="200" Click="RemoveStudentClick"/>
    </Grid>
</Window>
