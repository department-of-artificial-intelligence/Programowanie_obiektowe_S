<Window x:Class="Lab8.WpfApp.AddGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Grade" Height="300" Width="400">
    <Grid Margin="10">
        <Label Content="Subject:" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox x:Name="TextBoxSubject" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,10,10,0" Width="200"/>

        <Label Content="Score:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,40,0,0"/>
        <TextBox x:Name="TextBoxScore" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,40,10,0" Width="200"/>

        <Label Content="Date:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,80,0,0"/>
        <DatePicker x:Name="DatePickerGradeDate" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,80,10,0" Width="200"/>

        <Button Content="Add Grade" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,120,0,0" Width="200" Height="30" Click="ButtonAddGrade_Click"/>
    </Grid>
</Window>
