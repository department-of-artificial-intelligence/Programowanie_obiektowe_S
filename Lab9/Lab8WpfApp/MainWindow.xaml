<Window x:Class="Lab8WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="AddStudent" Content="Add Student" HorizontalAlignment="Left" Margin="10,37,0,0" VerticalAlignment="Top" Width="99" Height="36" Click="ButtonAddStudentWindowShow_Click"/>
        <Button x:Name="DeleteStudent" Content="Delete Student" HorizontalAlignment="Left" Margin="114,37,0,0" VerticalAlignment="Top" Width="94" Height="36" Click="ButtonRemoveStudentWindowShow_Click"/>
        <DataGrid Name="DataGridStudents" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,78,0,-78"/>
        <Button Content="Save to txt file     " HorizontalAlignment="Left" Margin="213,33,0,0" VerticalAlignment="Top"/>
        <Button Content="Load from txt file" HorizontalAlignment="Left" Margin="213,53,0,0" VerticalAlignment="Top"/>
        <Button Content="Save to XML file     " HorizontalAlignment="Left" Margin="312,30,0,0" VerticalAlignment="Top"/>
        <Button Content="Save to JSON file     " HorizontalAlignment="Left" Margin="421,30,0,0" VerticalAlignment="Top"/>
        <Button Content="Load from XML file" HorizontalAlignment="Left" Margin="312,53,0,0" VerticalAlignment="Top"/>
        <Button Content="Load from JSON file" HorizontalAlignment="Left" Margin="421,53,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
