<Window x:Class="Lab9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab9"
        mc:Ignorable="d"
             Title="Students" Height="450" Width="800">
    <Grid Margin="1,0,-1,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="181*"/>
            <ColumnDefinition Width="19*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="DataGridStudents" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="DataGridStudents_SelectionChanged" Margin="10,107,62,-35" RenderTransformOrigin="0.809,0.717" Grid.ColumnSpan="2"/>
        <DataGrid x:Name="DataGridGrades" HorizontalAlignment="Left" Margin="28,284,0,0" VerticalAlignment="Top" Width="692" Height="98" AutoGenerateColumns="True"/>
        <Button x:Name="AddStudent" Content="Add student" HorizontalAlignment="Left" Margin="10,24,0,0" VerticalAlignment="Top" Width="98" RenderTransformOrigin="0.031,0.453" Click="AddStudent_Click" Height="20"/>
        <Button x:Name="DeleteStudent" Content="Delete student" HorizontalAlignment="Left" Margin="120,24,0,0" VerticalAlignment="Top" Width="98" RenderTransformOrigin="0.031,0.453" Click="ButtonRemoveStudentWindowShow_Click" Height="20"/>
        <Button x:Name="EditStudent" Content="Edit Student" HorizontalAlignment="Left" Margin="229,24,0,0" VerticalAlignment="Top" Width="98" Click="EditStudent_Click" Height="20"/>
        <Button Content="Add Grade" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="30" Margin="120,249,0,0" Click="AddGrade_Click" RenderTransformOrigin="0.503,1.801"/>
        <Button Content="Close stream" HorizontalAlignment="Left" Margin="367,0,0,0" VerticalAlignment="Top" Height="17" Width="97" />
        <Button Content="Load another student" HorizontalAlignment="Left" Margin="367,19,0,0" VerticalAlignment="Top" Height="17" Width="127"/>
        <Button Content="Save to txt file" HorizontalAlignment="Left" Click="SaveFile_Click" Margin="367,61,0,0" VerticalAlignment="Top" Height="18" Width="97"/>
        <Button Content="Load from txt file(Stream)"  HorizontalAlignment="Left" Margin="367,39,0,0" VerticalAlignment="Top" Height="17" Width="149"/>
        <Button Content="Load from txt file" Click="LoadFile_Click"  HorizontalAlignment="Left" Margin="367,84,0,0" VerticalAlignment="Top" Height="18" Width="97"/>
        <Button Content="Save to XML file" HorizontalAlignment="Left" Margin="479,61,0,0" VerticalAlignment="Top" Height="18" Width="112" />
        <Button Content="Save to JSON File" HorizontalAlignment="Left" Margin="606,64,0,0" VerticalAlignment="Top" Height="18" Width="114" RenderTransformOrigin="-0.26,0.799"/>
        <Button Content="Load from XML file" HorizontalAlignment="Left" Margin="479,84,0,0" VerticalAlignment="Top" Height="18" Width="112"/>
        <Button Content="Load from JSON file" HorizontalAlignment="Left" Margin="606,84,0,0" VerticalAlignment="Top" Height="18" Width="114"/>
    </Grid>
</Window>
