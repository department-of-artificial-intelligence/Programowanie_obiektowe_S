<Window x:Class="Labs8.WpfApp.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labs8.WpfApp"
        mc:Ignorable="d"
        Title="StudentWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="TBox_FirstName" HorizontalAlignment="Left" Height="18" Margin="203,86,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="115"/>
        <TextBox x:Name="TBox_SurName" HorizontalAlignment="Left" Height="22" Margin="203,109,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="115"/>
        <TextBox x:Name="TBox_StudentNo" HorizontalAlignment="Left" Height="21" Margin="203,136,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="115"/>
        <TextBox x:Name="TBox_Faculty" HorizontalAlignment="Left" Height="18" Margin="203,165,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="115"/>
        <Label Content="First name:" HorizontalAlignment="Left" Height="26" Margin="103,83,0,0" VerticalAlignment="Top" Width="100"/>
        <Label Content="Sur name:" HorizontalAlignment="Left" Height="26" Margin="103,107,0,0" VerticalAlignment="Top" Width="100"/>
        <Label Content="Student no.:" HorizontalAlignment="Left" Height="26" Margin="103,131,0,0" VerticalAlignment="Top" Width="100"/>
        <Label Content="Faculty:" HorizontalAlignment="Left" Height="26" Margin="103,161,0,0" VerticalAlignment="Top" Width="100"/>
        <Button x:Name="Button2AddStudent" Content="Add student" HorizontalAlignment="Left" Margin="143,204,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
