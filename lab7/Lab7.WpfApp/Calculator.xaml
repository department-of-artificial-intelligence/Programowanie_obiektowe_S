<Window x:Class="Lab7.WpfApp.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab7.WpfApp"
        mc:Ignorable="d"
        Title="Calculator" Height="550" Width="450">
    <Grid>
        <Button x:Name="btn_0" Content="0" HorizontalAlignment="Left" Margin="28,169,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_1" Content="1" HorizontalAlignment="Left" Margin="85,169,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_2" Content="2" HorizontalAlignment="Left" Margin="141,169,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_3" Content="3" HorizontalAlignment="Left" Margin="28,227,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_4" Content="4" HorizontalAlignment="Left" Margin="85,227,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_5" Content="5" HorizontalAlignment="Left" Margin="141,227,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_6" Content="6" HorizontalAlignment="Left" Margin="28,285,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_7" Content="7" HorizontalAlignment="Left" Margin="85,285,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_8" Content="8" HorizontalAlignment="Left" Margin="141,285,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_9" Content="9" HorizontalAlignment="Left" Margin="28,339,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <TextBox x:Name="tb" HorizontalAlignment="Center" Margin="0,23,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="350" TextChanged="TextBox_TextChanged" Height="30"/>
        <Button x:Name="btn_dot" Content="." HorizontalAlignment="Left" Margin="85,451,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_clear" Content="C" HorizontalAlignment="Left" Margin="386,144,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_multiply" Content="*" HorizontalAlignment="Left" Margin="386,202,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_div" Content="/" HorizontalAlignment="Left" Margin="386,260,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_minus" Content="-" HorizontalAlignment="Left" Margin="329,260,0,0" VerticalAlignment="Top" Height="40" Width="40" Click="Button_Click"/>
        <Button x:Name="btn_eq" Content="=" HorizontalAlignment="Left" Margin="329,319,0,0" VerticalAlignment="Top" Height="40" Width="97" Click="Button_Click"/>
        <Button x:Name="btn_plus" Content="+" HorizontalAlignment="Left" Margin="329,144,0,0" VerticalAlignment="Top" Height="98" Width="40" Click="Button_Click"/>

    </Grid>
</Window>
