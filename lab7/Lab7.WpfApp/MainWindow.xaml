<Window x:Class="Lab7.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab7.WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="270">
    <Grid Margin="10,-16,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="237*"/>
            <RowDefinition Height="163*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="451*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="oneButton" Content="1" Width ="40" Height="40" HorizontalAlignment="Left" Margin="7,215,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.565,0.421" Grid.RowSpan="2" Click="OnButtonNumberClick"/>
        <Button x:Name="twoButton" Content="2" Width ="40" Height="40" HorizontalAlignment="Left" Margin="52,215,0,0" VerticalAlignment="Top" Grid.RowSpan="2" Click="OnButtonNumberClick"/>
        <Button x:Name="threeButton" Content="3" Width ="40" Height="40" HorizontalAlignment="Left" Margin="97,215,0,0" VerticalAlignment="Top" Grid.RowSpan="2" Click="OnButtonNumberClick"/>
        <Button x:Name="fourButton" Content="4" Width ="40" Height="40" HorizontalAlignment="Left" Margin="7,23,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonNumberClick"/>
        <Button x:Name="fiveButton" Content="5" Width ="40" Height="40" HorizontalAlignment="Left" Margin="52,23,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonNumberClick"/>
        <Button x:Name="sixButton" Content="6" Width ="40" Height="40" HorizontalAlignment="Left" Margin="97,23,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonNumberClick"/>
        <Button x:Name="sevenButton" Content="7" Width ="40" Height="40" HorizontalAlignment="Left" Margin="7,68,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonNumberClick"/>
        <Button x:Name="eightButton" Content="8" Width ="40" Height="40" HorizontalAlignment="Left" Margin="52,68,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonNumberClick"/>
        <Button x:Name="nineButton" Content="9" Width ="40" Height="40" HorizontalAlignment="Left" Margin="97,68,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonNumberClick"/>
        <Button x:Name="zeroButton" Content="0" Width ="40" Height="40" HorizontalAlignment="Left" Margin="52,113,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonNumberClick"/>
        <Button x:Name="dotButton" Content="." Width ="40" Height="40" HorizontalAlignment="Left" Margin="97,113,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonNumberClick"/>
        <Button x:Name="cleanButton" Content="C" Width ="40" Height="40" HorizontalAlignment="Left" Margin="154,215,0,0" VerticalAlignment="Top" Grid.RowSpan="2" Click="OnButtonClearClick"/>
        <Button x:Name="addButton" Content="+" Width ="40" Height="85" HorizontalAlignment="Left" Margin="199,215,0,0" VerticalAlignment="Top" Grid.RowSpan="2" Click="OnButtonOperationClick"/>
        <Button x:Name="subButton" Content="-" Width ="40" Height="40" HorizontalAlignment="Left" Margin="154,23,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonOperationClick"/>
        <Button x:Name="mulButton" Content="*" Width ="40" Height="40" HorizontalAlignment="Left" Margin="154,68,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonOperationClick"/>
        <Button x:Name="divButton" Content="/" Width ="40" Height="40" HorizontalAlignment="Left" Margin="154,113,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonOperationClick"/>
        <Button x:Name="equalButton" Content="=" Width ="40" Height="85" HorizontalAlignment="Left" Margin="199,68,0,0" VerticalAlignment="Top" Grid.Row="1" Click="OnButtonResultClick"/>
        <TextBox x:Name="display" HorizontalAlignment="Left" Margin="27,155,0,0" TextWrapping="Wrap" Text="" TextAlignment="Right" VerticalAlignment="Top" Width="218" Height="28" FontSize="20"/>

    </Grid>
</Window>
