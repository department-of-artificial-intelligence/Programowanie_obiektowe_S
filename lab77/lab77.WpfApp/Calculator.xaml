<Window x:Class="lab77.WpfApp.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab77.WpfApp"
        mc:Ignorable="d"
        Title="Calculator" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="pole" HorizontalAlignment="Left" Margin="149,31,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="zero" Content="0" HorizontalAlignment="Left" Margin="62,123,0,0" VerticalAlignment="Top" Width="20" Click="zero_Click"/>
        <Button x:Name="one" Content="1" HorizontalAlignment="Left" Margin="111,123,0,0" VerticalAlignment="Top" Width="20" Click="Button_Click_1" IsCancel="True"/>
        <Button x:Name="two" Content="2" HorizontalAlignment="Left" Margin="160,123,0,0" VerticalAlignment="Top" Width="20" Click="two_Click"/>
        <Button x:Name="three" Content="3" HorizontalAlignment="Left" Margin="62,150,0,0" VerticalAlignment="Top" Width="20" Click="three_Click"/>
        <Button x:Name="four" Content="4" HorizontalAlignment="Left" Margin="111,150,0,0" VerticalAlignment="Top" Width="20" Click="four_Click"/>
        <Button x:Name="five" Content="5" HorizontalAlignment="Left" Margin="160,150,0,0" VerticalAlignment="Top" Width="20" Click="Button_Click"/>
        <Button x:Name="six" Content="6" HorizontalAlignment="Left" Margin="62,178,0,0" VerticalAlignment="Top" Width="20" Click="six_Click"/>
        <Button x:Name="seven" Content="7" HorizontalAlignment="Left" Margin="111,178,0,0" VerticalAlignment="Top" Width="20" Click="seven_Click"/>
        <Button x:Name="eight" Content="8" HorizontalAlignment="Left" Margin="160,178,0,0" VerticalAlignment="Top" Width="20" Click="eight_Click"/>
        <Button x:Name="nine" Content="9" HorizontalAlignment="Left" Margin="62,0,0,0" VerticalAlignment="Center" Width="20" Click="nine_click"/>
        <Button Content="." HorizontalAlignment="Left" Margin="121,230,0,0" VerticalAlignment="Top" Width="20"/>
        <Button Content="+" HorizontalAlignment="Left" Margin="252,89,0,0" VerticalAlignment="Top" Width="20" Height="45"/>
        <Button Content="C" HorizontalAlignment="Left" Margin="277,89,0,0" VerticalAlignment="Top" Width="20"/>
        <Button Content="-&#xD;&#xA;" HorizontalAlignment="Left" Margin="252,139,0,0" VerticalAlignment="Top" Height="20" Width="20"/>
        <Button Content="*" HorizontalAlignment="Left" Margin="277,114,0,0" VerticalAlignment="Top" Width="20" Height="20"/>
        <Button Content="=&#xD;&#xA;" HorizontalAlignment="Left" Margin="252,164,0,0" VerticalAlignment="Top" Width="45" Height="20"/>
        <Button Content="/&#xD;&#xA;" HorizontalAlignment="Left" Margin="277,139,0,0" VerticalAlignment="Top" Width="20" Height="20"/>

    </Grid>
</Window>
