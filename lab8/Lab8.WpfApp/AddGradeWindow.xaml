<Window x:Class="Lab8.WpfApp.AddGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="Add Grade" Height="450" Width="500">
    <Grid>
        <DataGrid x:Name="Grades" HorizontalAlignment="Left" Height="255" Margin="121,42,0,0" VerticalAlignment="Top" Width="234" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <Button x:Name="b1" Content="Add grades" HorizontalAlignment="Left" Height="51" Margin="121,344,0,0" VerticalAlignment="Top" Width="234" FontSize="16" Click="b1_Click"/>
    </Grid>
</Window>
