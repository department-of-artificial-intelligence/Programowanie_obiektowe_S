<Window x:Class="Lab8.WpfApp.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="AddStudentWindow" Height="250" Width="300">
    <Grid>
        <Label Content="First Name:" HorizontalAlignment="Left" Margin="12,44,0,0" VerticalAlignment="Top"/>
        <Label Content="Surname:" HorizontalAlignment="Left" Margin="21,75,0,0" VerticalAlignment="Top"/>
        <Label Content="Student No.:" HorizontalAlignment="Left" Margin="4,106,0,0" VerticalAlignment="Top" Width="76"/>
        <Label Content="Faculty:" HorizontalAlignment="Left" Margin="31,137,0,0" VerticalAlignment="Top"/>
        <TextBox Name="TextBoxFirstName" HorizontalAlignment="Left" TextAlignment="Center" VerticalContentAlignment="Center" Height="26" Margin="96,44,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="TextBoxSurname" HorizontalAlignment="Left" TextAlignment="Center" VerticalContentAlignment="Center" Height="26" Margin="96,75,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="TextBoxStudentNo" HorizontalAlignment="Left" TextAlignment="Center" VerticalContentAlignment="Center" Height="26" Margin="96,106,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="TextBoxFaculty" HorizontalAlignment="Left" TextAlignment="Center" VerticalContentAlignment="Center" Height="26" Margin="96,137,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button Name ="ButtonAddStudent" Content="Add Student" HorizontalAlignment="Left" Height="27" Margin="10,182,0,0" VerticalAlignment="Top" Width="206" Click="ButtonAddStudent_Click"/>

    </Grid>
</Window>
