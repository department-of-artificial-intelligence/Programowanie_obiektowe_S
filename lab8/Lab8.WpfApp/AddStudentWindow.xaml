<Window x:Class="Lab8.WpfApp.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="AddStudentWindow" Height="450" Width="400">
    <Grid>
        <Label Content="First name:" HorizontalAlignment="Left" Height="37" Margin="60,120,0,0" VerticalAlignment="Top" Width="102" FontSize="16"/>
        <TextBox x:Name="t1" HorizontalAlignment="Left" Height="18" Margin="178,124,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="111"/>
        <Label Content="Last name:" HorizontalAlignment="Left" Height="37" Margin="60,162,0,0" VerticalAlignment="Top" Width="102" FontSize="16"/>
        <TextBox x:Name="t2" HorizontalAlignment="Left" Height="18" Margin="178,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="111"/>
        <Label Content="Faculty" HorizontalAlignment="Left" Height="37" Margin="60,204,0,0" VerticalAlignment="Top" Width="102" FontSize="16" RenderTransformOrigin="0.484,1.404"/>
        <TextBox x:Name="t3" HorizontalAlignment="Left" Height="18" Margin="178,214,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="111"/>
        <Label Content="Student ID" HorizontalAlignment="Left" Height="37" Margin="60,246,0,0" VerticalAlignment="Top" Width="102" FontSize="16" RenderTransformOrigin="0.484,1.404"/>
        <TextBox x:Name="t4" HorizontalAlignment="Left" Height="18" Margin="178,256,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="111"/>
        <Button x:Name="b1" Content="Add student" HorizontalAlignment="Left" Height="49" Margin="60,318,0,0" VerticalAlignment="Top" Width="229" FontSize="14" Click="b1_Click"/>

    </Grid>
</Window>
