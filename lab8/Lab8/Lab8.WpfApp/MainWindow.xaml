<Window x:Class="Lab8.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab8.WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="PrzyciskDodaj" Content="Add Student" HorizontalAlignment="Left" Height="25" Margin="65,54,0,0" VerticalAlignment="Top" Width="85" Click="PrzyciskDodaj_Click"/>
        <Button x:Name="PrzyciskUsun" Content="Delete Student" HorizontalAlignment="Left" Height="23" Margin="203,66,0,0" VerticalAlignment="Top" Width="90" Click="PrzyciskUsun_Click"/>
        <DataGrid x:Name="DataGridStudents" HorizontalAlignment="Left" Height="138" Margin="84,150,0,0" VerticalAlignment="Top" Width="405" d:ItemsSource="{d:SampleData ItemCount=5}"/>

    </Grid>
</Window>
