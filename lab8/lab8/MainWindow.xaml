<Window x:Class="lab8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab8"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="DataGridStudents" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="DataGrid_SelectionChanged"/>
        <Button Content="Add Student" HorizontalAlignment="Left" Margin="65,258,0,0" VerticalAlignment="Top" Click="dodajStudenta"/>
        <Button x:Name="del" Content="Delete Student" HorizontalAlignment="Left" Margin="205,258,0,0" VerticalAlignment="Top" Click="usun"/>

    </Grid>
</Window>
