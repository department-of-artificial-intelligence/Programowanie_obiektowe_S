<Window x:Class="laboratorium7.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:laboratorium7"
        mc:Ignorable="d"
        Title="Calculator" Height="450" Width="800">
    <Grid>
        <Button Content="0" HorizontalAlignment="Left" Margin="70
                ,0,0,0" VerticalAlignment="Center" Height="32" Width="40
                " Click="kliknij"/>
        <Button Content="1" HorizontalAlignment="Left" Margin="110,0,0,0" VerticalAlignment="Center" Height="32" Width="40
                " Click="kliknij"/>
        <Button Content="2" HorizontalAlignment="Left" Margin="150,0,0,0" VerticalAlignment="Center" Height="32
                " Width="40" Click="kliknij"/>
        <Button Content="3" HorizontalAlignment="Left" Margin="70,233,0,0" VerticalAlignment="Top" Height="32" Width="40" Click="kliknij"/>
        <Button Content="4" HorizontalAlignment="Left" Margin="110,233,0,0" VerticalAlignment="Top" Height="32" Width="40" Click="kliknij"/>
        <Button Content="5" HorizontalAlignment="Left" Margin="150,233,0,0" VerticalAlignment="Top" Height="32" Width="40" Click="kliknij"/>
        <Button Content="6" HorizontalAlignment="Left" Margin="70,265,0,0" VerticalAlignment="Top" Height="32" Width="40" Click="kliknij"/>
        <Button Content="7" HorizontalAlignment="Left" Margin="110,265,0,0" VerticalAlignment="Top" Height="32" Width="40" Click="kliknij"/>
        <Button Content="8" HorizontalAlignment="Left" Margin="150,265,0,0" VerticalAlignment="Top" Height="32" Width="40" Click="kliknij"/>
        <Button Content="9" HorizontalAlignment="Left" Margin="70,297,0,0" VerticalAlignment="Top" Height="32" Width="40" Click="kliknij"/>
        <Button Content="." HorizontalAlignment="Left" Margin="110,329,0,0" VerticalAlignment="Top" Height="32" Width="40" Click="kliknij"/>
        <Button Content="=" HorizontalAlignment="Left" Margin="400,297,0,0" VerticalAlignment="Top" Height="32" Width="80"/>
        <Button Content="-" HorizontalAlignment="Left" Margin="400,265,0,0" VerticalAlignment="Top" Height="32" Width="40"/>
        <Button Content="/" HorizontalAlignment="Left" Margin="440,265,0,0" VerticalAlignment="Top" Height="32" Width="40"/>
        <Button Content="*" HorizontalAlignment="Left" Margin="440,233,0,0" VerticalAlignment="Top" Height="32" Width="40"/>
        <Button Content="C" HorizontalAlignment="Left" Margin="440,0,0,0" VerticalAlignment="Center" Height="32" Width="40"/>
        <Button Content="+" HorizontalAlignment="Left" Margin="400,201,0,0" VerticalAlignment="Top" Height="64" Width="40"/>
        <TextBox x:Name="TekstCalc" HorizontalAlignment="Left" Margin="190,86,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="250" Height="40"/>

    </Grid>
</Window>
